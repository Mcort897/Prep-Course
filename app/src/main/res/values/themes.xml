<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ParentalControlPro" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/text_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_dark</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
    </style>

    <!-- Parent Theme -->
    <style name="Theme.ParentalControlPro.Parent" parent="Theme.ParentalControlPro">
        <item name="colorPrimary">@color/material_blue_500</item>
        <item name="colorPrimaryVariant">@color/material_blue_700</item>
    </style>

    <!-- Child Theme -->
    <style name="Theme.ParentalControlPro.Child" parent="Theme.ParentalControlPro">
        <item name="colorPrimary">@color/material_green_500</item>
        <item name="colorPrimaryVariant">@color/material_green_700</item>
    </style>

    <!-- Card Style -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- Button Styles -->
    <style name="ButtonStyle.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ButtonStyle.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ButtonStyle.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextStyle.Headline1" parent="Widget.Material3.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.Headline2" parent="Widget.Material3.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.Headline3" parent="Widget.Material3.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.Body1" parent="Widget.Material3.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.Body2" parent="Widget.Material3.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextStyle.Caption" parent="Widget.Material3.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- Input Styles -->
    <style name="InputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- Progress Bar Styles -->
    <style name="ProgressBarStyle" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/primary_light</item>
        <item name="android:layout_height">4dp</item>
    </style>

    <!-- Time Control Styles -->
    <style name="TimeControlStyle.Available" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/time_available</item>
        <item name="android:alpha">0.1</item>
    </style>

    <style name="TimeControlStyle.Warning" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/time_warning</item>
        <item name="android:alpha">0.1</item>
    </style>

    <style name="TimeControlStyle.Exceeded" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/time_exceeded</item>
        <item name="android:alpha">0.1</item>
    </style>

    <!-- App Status Styles -->
    <style name="AppStatusStyle.Allowed" parent="Widget.Material3.Chip">
        <item name="chipBackgroundColor">@color/app_allowed</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <style name="AppStatusStyle.Blocked" parent="Widget.Material3.Chip">
        <item name="chipBackgroundColor">@color/app_blocked</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <style name="AppStatusStyle.Restricted" parent="Widget.Material3.Chip">
        <item name="chipBackgroundColor">@color/app_restricted</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <!-- Floating Action Button Style -->
    <style name="FloatingActionButtonStyle" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="tint">@color/text_white</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Dialog Styles -->
    <style name="DialogStyle" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_white</item>
    </style>

    <!-- Splash Screen Style -->
    <style name="SplashScreenStyle" parent="Theme.ParentalControlPro">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>